# Copia in wargame-server/.env e adatta. Le variabili d'ambiente già impostate hanno la precedenza.
# OmniRoute (endpoint OpenAI-compatible)
LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=sk-...            # solo se hai attivato l'autenticazione su OmniRoute

# Modello (o alias/combo di OmniRoute) di default per tutti i ruoli
LLM_MODEL=wargame-light
# Override per ruolo: FACTION_MAJOR, FACTION_MINOR, GM_NARRATOR, INTEL_ANALYST, ORDER_PARSER, REFLECTION, REPAIR, DIPLOMAT,
# STRATEGIST (direttive strategiche delle grandi potenze), CHANCERY (frasi delle cancellerie). Vincono sul profilo (LLM_PROFILE).
LLM_MODEL_FACTION_MAJOR=wargame-strong
LLM_MODEL_GM_NARRATOR=wargame-strong
# lettere tra capi di Stato (senza questa riga: il modello di FACTION_MAJOR)
# LLM_MODEL_DIPLOMAT=wargame-light
# LLM_TEMPERATURE_FACTION_MAJOR=0.5
# LLM_MAX_TOKENS_FACTION_MAJOR=3000
LLM_TIMEOUT_MS=180000
# json_schema (predefinito) oppure json_object: alcuni provider (es. Cohere) rifiutano lo schema del gioco
# LLM_RESPONSE_FORMAT=json_object
# campi extra per ogni richiesta, in JSON (es. modelli locali con ragionamento: spegnerlo)
# LLM_EXTRA_BODY={"reasoning_effort":"none"}

# ——— Profili di provider: per ogni ruolo un elenco ordinato di modelli (principale + ripiego su 429 o errore) ———
# Un profilo è un file in wargame-server/llm-profiles/<nome>.json (esempi: locale, gemini, omniroute) oppure un JSON qui sotto.
# Senza LLM_PROFILE vale la configurazione di sempre (LLM_BASE_URL, LLM_MODEL, LLM_MODEL_<RUOLO>). Le chiavi stanno SOLO in .env.
# LLM_PROFILE=locale              # Ollama di casa (qwen3.5 4B/9B, ragionamento spento); OLLAMA_BASE_URL se non è localhost:11434
# LLM_PROFILE=gemini              # Google AI Studio: Gemini 2.5 Flash e Flash-Lite, ognuno ripiego dell'altro
# GEMINI_API_KEY=                 # chiave di AI Studio (https://aistudio.google.com/apikey), usata dal profilo gemini
# LLM_PROFILE=omniroute           # un solo LLM_BASE_URL con le combo wargame-strong / wargame-light
# LLM_PROFILE_JSON={"name":"mio","roles":{"default":[{"baseUrl":"http://localhost:20128/v1","model":"wargame-light","rpm":8}]}}
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ——— Budget delle chiamate LLM (agents/budget.ts) ———
# Chiamate al modello per turno (coda a priorità: Console Ordini e briefing, lettere con il giocatore, notizie, direttive, reazioni delle
# cancellerie, lettere tra IA); finito il budget ogni ruolo usa il suo testo deterministico. 0 = nessuna chiamata (si gioca con soli testi
# deterministici). Predefinito: 10 nelle campagne a regole, nessun tetto in modalità llm. «unlimited» toglie il tetto.
# LLM_BUDGET_CALLS=10
# Richieste al minuto e al giorno per modello (finestra scorrevole; i profili possono avere i loro rpm/rpd per endpoint). Con OmniRoute
# metti il limite più basso tra i provider della combo. 0 = nessun limite. Il limite del giorno riparte da zero al riavvio del server.
# LLM_RPM=8
# LLM_RPD=1000
# Attesa massima di un posto nel limite al minuto prima di passare al testo deterministico (ms)
# LLM_MAX_WAIT_MS=45000

# Server del gioco
# Chi decide le mosse delle fazioni non giocate da te nelle campagne nuove:
#   rules (predefinito) = regole deterministiche del motore, turno di circa 1 minuto con i modelli locali (l'LLM scrive solo
#                         lettere, notizie, briefing e interpreta la Console Ordini)
#   llm                 = come prima: una chiamata FACTION_MAJOR/FACTION_MINOR per fazione più la riflessione (per confronti)
# WARGAME_FACTION_MODE=rules
# WARGAME_PORT=8787
# WARGAME_MOCK=1                 # agenti finti deterministici, nessuna chiamata LLM
# WARGAME_ALLOW_OFFLINE=1        # ▶ anche con i modelli irraggiungibili (turni con gli ordini di dottrina); senza: 503 LLM_UNREACHABLE
# Risparmio di chiamate LLM per le campagne nuove in modalità llm (1 = sempre con l'IA; si cambia anche con POST /config agentCadence)
# WARGAME_MINOR_EVERY=2           # fazioni minori con l'IA un turno ogni 2 (0 = solo dottrina)
# WARGAME_REFLECT_EVERY=3         # memoria aggiornata dall'IA ogni 3 turni
# WARGAME_LETTERS_PER_TURN=3      # lettere IA di iniziativa per turno (0 = solo risposte alle lettere del giocatore)
