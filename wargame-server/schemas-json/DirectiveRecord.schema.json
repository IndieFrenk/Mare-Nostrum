{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "schemaVersion": {
   "type": "number",
   "const": 1
  },
  "turn": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "factionId": {
   "type": "string",
   "minLength": 2
  },
  "source": {
   "type": "string",
   "enum": [
    "llm",
    "none"
   ]
  },
  "model": {
   "type": "string"
  },
  "promptHash": {
   "type": "string"
  },
  "contextTokens": {
   "type": "number"
  },
  "request": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "system": {
       "type": "string"
      },
      "user": {
       "type": "string"
      }
     },
     "required": [
      "system",
      "user"
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "response": {
   "type": [
    "string",
    "null"
   ]
  },
  "proposed": {
   "anyOf": [
    {},
    {
     "type": "null"
    }
   ]
  },
  "limited": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "horizonTurns": {
       "type": "integer",
       "minimum": 3,
       "maximum": 6
      },
      "priorities": {
       "default": [],
       "maxItems": 4,
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "kind": {
          "type": "string",
          "enum": [
           "improve",
           "court",
           "deter",
           "isolate",
           "contain"
          ]
         },
         "target": {
          "type": "string",
          "minLength": 2
         },
         "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        },
        "required": [
         "kind",
         "target",
         "weight"
        ]
       }
      },
      "zoneInterestDelta": {
       "default": {},
       "type": "object",
       "propertyNames": {
        "type": "string"
       },
       "additionalProperties": {
        "type": "number",
        "minimum": -0.2,
        "maximum": 0.2
       }
      },
      "seekAgreements": {
       "default": [],
       "maxItems": 2,
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "enum": [
           "defense",
           "energy",
           "basing",
           "migration",
           "ceasefire",
           "arms_sale",
           "intel_sharing",
           "secret",
           "non_aggression",
           "guarantee",
           "military_access",
           "defense_cooperation",
           "trade"
          ]
         },
         "with": {
          "type": "string",
          "minLength": 2
         }
        },
        "required": [
         "type",
         "with"
        ]
       }
      },
      "avoid": {
       "default": [],
       "maxItems": 2,
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 2
       }
      },
      "rationale": {
       "default": "",
       "type": "string",
       "maxLength": 420
      }
     },
     "required": [
      "horizonTurns"
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "limits": {
   "default": [],
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "errors": {
   "default": [],
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "usage": {
   "type": "object",
   "properties": {
    "promptTokens": {
     "type": "number"
    },
    "completionTokens": {
     "type": "number"
    },
    "latencyMs": {
     "type": "number"
    }
   },
   "required": [
    "promptTokens",
    "completionTokens",
    "latencyMs"
   ]
  }
 },
 "required": [
  "schemaVersion",
  "turn",
  "factionId",
  "source",
  "model",
  "promptHash",
  "contextTokens",
  "request",
  "response",
  "proposed",
  "limited",
  "usage"
 ]
}