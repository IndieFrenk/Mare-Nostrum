{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "turn": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "zoneId": {
   "type": "string"
  },
  "location": {
   "type": "object",
   "properties": {
    "lat": {
     "type": "number"
    },
    "lon": {
     "type": "number"
    }
   },
   "required": [
    "lat",
    "lon"
   ]
  },
  "sides": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "factionId": {
      "type": "string",
      "minLength": 2
     },
     "unitIds": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "factionId",
     "unitIds"
    ]
   }
  },
  "scale": {
   "type": "string",
   "enum": [
    "minor",
    "major"
   ]
  },
  "resolution": {
   "type": "string",
   "enum": [
    "auto",
    "cmo"
   ]
  },
  "status": {
   "type": "string",
   "enum": [
    "pending_cmo",
    "resolved"
   ]
  },
  "cmoPackage": {
   "type": "object",
   "properties": {
    "engagementId": {
     "type": "string"
    },
    "headline": {
     "type": "string",
     "const": "RISOLUZIONE SU CMO RICHIESTA"
    },
    "playerForces": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "unitId": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "classId": {
        "type": "string"
       },
       "loadout": {
        "type": "object",
        "propertyNames": {
         "type": "string"
        },
        "additionalProperties": {
         "type": "number"
        }
       },
       "readiness": {
        "type": "number"
       }
      },
      "required": [
       "unitId",
       "name",
       "classId",
       "loadout",
       "readiness"
      ]
     }
    },
    "enemyOobEstimate": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "classification": {
        "type": "string"
       },
       "estCount": {
        "type": "array",
        "prefixItems": [
         {
          "type": "number"
         },
         {
          "type": "number"
         }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
       },
       "confidence": {
        "type": "number"
       },
       "notes": {
        "type": "string"
       }
      },
      "required": [
       "classification",
       "estCount",
       "confidence",
       "notes"
      ]
     }
    },
    "environment": {
     "type": "object",
     "properties": {
      "date": {
       "type": "string"
      },
      "timeWindowUtc": {
       "type": "string"
      },
      "seaState": {
       "type": "number"
      },
      "visibilityKm": {
       "type": "number"
      },
      "wind": {
       "type": "string"
      },
      "clouds": {
       "type": "string"
      },
      "ducting": {
       "type": "boolean"
      }
     },
     "required": [
      "date",
      "timeWindowUtc",
      "seaState",
      "visibilityKm",
      "wind",
      "clouds",
      "ducting"
     ]
    },
    "roe": {
     "type": "string",
     "enum": [
      "WEAPONS_HOLD",
      "WEAPONS_TIGHT",
      "WEAPONS_FREE"
     ]
    },
    "objectives": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "constraints": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "suggestedScenarioArea": {
     "type": "object",
     "properties": {
      "center": {
       "type": "object",
       "properties": {
        "lat": {
         "type": "number"
        },
        "lon": {
         "type": "number"
        }
       },
       "required": [
        "lat",
        "lon"
       ]
      },
      "radiusKm": {
       "type": "number"
      }
     },
     "required": [
      "center",
      "radiusKm"
     ]
    }
   },
   "required": [
    "engagementId",
    "headline",
    "playerForces",
    "enemyOobEstimate",
    "environment",
    "roe",
    "objectives",
    "constraints",
    "suggestedScenarioArea"
   ]
  },
  "aar": {
   "type": "object",
   "properties": {
    "submittedAt": {
     "type": "string"
    },
    "ownLosses": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "unitId": {
        "type": "string"
       },
       "newStatus": {
        "type": "string",
        "enum": [
         "ready",
         "deployed",
         "transit",
         "maintenance",
         "damaged",
         "destroyed"
        ]
       },
       "damage": {
        "type": "number"
       },
       "aircraftLost": {
        "type": "number"
       }
      },
      "required": [
       "unitId",
       "newStatus",
       "damage"
      ]
     }
    },
    "munitionsExpended": {
     "type": "object",
     "propertyNames": {
      "type": "string"
     },
     "additionalProperties": {
      "type": "number"
     }
    },
    "enemyClaims": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "classification": {
        "type": "string"
       },
       "result": {
        "type": "string",
        "enum": [
         "destroyed",
         "damaged",
         "withdrew"
        ]
       }
      },
      "required": [
       "classification",
       "result"
      ]
     }
    },
    "outcome": {
     "type": "string",
     "enum": [
      "victory",
      "draw",
      "defeat"
     ]
    },
    "notes": {
     "type": "string"
    }
   },
   "required": [
    "submittedAt",
    "ownLosses",
    "munitionsExpended",
    "enemyClaims",
    "outcome",
    "notes"
   ]
  },
  "autoResult": {
   "type": "object",
   "properties": {
    "rollIds": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "summary": {
     "type": "string"
    }
   },
   "required": [
    "rollIds",
    "summary"
   ]
  },
  "enemyLossesConfirmed": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "classification": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "destroyed",
       "damaged",
       "intact"
      ]
     }
    },
    "required": [
     "classification",
     "status"
    ]
   }
  }
 },
 "required": [
  "id",
  "turn",
  "zoneId",
  "location",
  "sides",
  "scale",
  "resolution",
  "status"
 ]
}