{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "iso3": {
   "type": "string",
   "pattern": "^[A-Z]{3}$"
  },
  "nameIt": {
   "type": "string"
  },
  "region": {
   "type": "string",
   "enum": [
    "Africa",
    "Americas",
    "Asia",
    "Europe",
    "Oceania"
   ]
  },
  "government": {
   "type": "string",
   "enum": [
    "democracy",
    "hybrid",
    "authoritarian",
    "absolute_monarchy",
    "theocracy",
    "military",
    "transitional"
   ]
  },
  "population": {
   "type": "number"
  },
  "gdpUsdB": {
   "type": "number"
  },
  "nuclear": {
   "type": "string",
   "enum": [
    "none",
    "latent",
    "declared",
    "nato_sharing"
   ]
  },
  "alignment": {
   "type": "object",
   "properties": {
    "west": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "china": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "russia": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "required": [
    "west",
    "china",
    "russia"
   ]
  },
  "factionId": {
   "type": "string"
  }
 },
 "required": [
  "iso3",
  "nameIt",
  "region",
  "government",
  "population",
  "gdpUsdB",
  "nuclear",
  "alignment"
 ]
}