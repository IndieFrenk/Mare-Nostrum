{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "schemaVersion": {
   "type": "number",
   "const": 1
  },
  "factionId": {
   "type": "string",
   "minLength": 2
  },
  "updatedTurn": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "strategicGoals": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "commitments": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "turn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "to": {
      "type": "string",
      "minLength": 2
     },
     "promise": {
      "type": "string"
     },
     "kept": {
      "type": [
       "boolean",
       "null"
      ]
     }
    },
    "required": [
     "turn",
     "to",
     "promise",
     "kept"
    ]
   }
  },
  "grievances": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "turn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "against": {
      "type": "string",
      "minLength": 2
     },
     "text": {
      "type": "string"
     },
     "weight": {
      "type": "number"
     }
    },
    "required": [
     "turn",
     "against",
     "text",
     "weight"
    ]
   }
  },
  "lessons": {
   "maxItems": 10,
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "relationshipNotes": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "minLength": 2
   },
   "additionalProperties": {
    "type": "string"
   }
  },
  "rollingSummary": {
   "type": "string"
  }
 },
 "required": [
  "schemaVersion",
  "factionId",
  "updatedTurn",
  "strategicGoals",
  "commitments",
  "grievances",
  "lessons",
  "relationshipNotes",
  "rollingSummary"
 ]
}