{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "turn": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "briefing": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string"
    },
    "sections": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "heading": {
        "type": "string",
        "enum": [
         "Quadro strategico",
         "Tracce e movimenti",
         "Allarmi intelligence",
         "Energia e rotte",
         "Stato FOED e prontezza"
        ]
       },
       "body": {
        "type": "string"
       }
      },
      "required": [
       "heading",
       "body"
      ]
     }
    },
    "factsRef": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "title",
    "sections",
    "factsRef"
   ]
  },
  "debriefing": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string"
    },
    "sections": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "heading": {
        "type": "string"
       },
       "body": {
        "type": "string"
       }
      },
      "required": [
       "heading",
       "body"
      ]
     }
    },
    "factsRef": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "title",
    "sections",
    "factsRef"
   ]
  },
  "news": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "turn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "outlet": {
      "type": "string"
     },
     "outletFaction": {
      "type": "string",
      "minLength": 2
     },
     "bias": {
      "type": "number"
     },
     "headline": {
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "zoneId": {
      "type": "string"
     },
     "factsRef": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "kind": {
      "type": "string",
      "const": "chancery"
     }
    },
    "required": [
     "id",
     "turn",
     "outlet",
     "outletFaction",
     "bias",
     "headline",
     "body",
     "factsRef"
    ]
   }
  }
 },
 "required": [
  "turn",
  "briefing",
  "news"
 ]
}