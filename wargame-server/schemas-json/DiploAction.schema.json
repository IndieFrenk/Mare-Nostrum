{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "oneOf": [
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "DEMARCHE",
      "THREAT",
      "REASSURANCE"
     ]
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "message": {
     "type": "string"
    },
    "visibility": {
     "anyOf": [
      {
       "type": "string",
       "const": "public"
      },
      {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 2
       }
      }
     ]
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "message",
    "visibility"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "PROPOSE_AGREEMENT"
    },
    "target": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 2
     }
    },
    "agreement": {
     "type": "object",
     "properties": {
      "type": {
       "type": "string",
       "enum": [
        "defense",
        "energy",
        "basing",
        "migration",
        "ceasefire",
        "arms_sale",
        "intel_sharing",
        "secret"
       ]
      },
      "parties": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 2
       }
      },
      "terms": {
       "type": "string"
      },
      "endTurn": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "maximum": 9007199254740991
        },
        {
         "type": "null"
        }
       ]
      },
      "visibility": {
       "anyOf": [
        {
         "type": "string",
         "const": "public"
        },
        {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 2
         }
        }
       ]
      }
     },
     "required": [
      "type",
      "parties",
      "terms",
      "endTurn",
      "visibility"
     ]
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "agreement"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "RESPOND_AGREEMENT"
    },
    "agreementId": {
     "type": "string"
    },
    "response": {
     "type": "string",
     "enum": [
      "accept",
      "reject",
      "counter"
     ]
    },
    "counterTerms": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "agreementId",
    "response"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "SANCTION",
      "LIFT_SANCTION"
     ]
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "scope": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "scope"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "BACKCHANNEL"
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "message": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "message"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "NATO_ART4",
      "EU_COUNCIL",
      "UNSC_DRAFT"
     ]
    },
    "subject": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "subject"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "ENERGY_DEAL"
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "infrastructureId": {
     "type": "string"
    },
    "terms": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "infrastructureId",
    "terms"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "AID"
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "amount": {
     "type": "number"
    },
    "type": {
     "type": "string",
     "enum": [
      "economic",
      "military"
     ]
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "amount",
    "type"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "LETTER"
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "subject": {
     "type": "string"
    },
    "body": {
     "type": "string"
    },
    "tone": {
     "type": "string",
     "enum": [
      "cordial",
      "formal",
      "firm",
      "threatening",
      "conciliatory"
     ]
    },
    "visibility": {
     "type": "string",
     "enum": [
      "private",
      "public"
     ]
    },
    "inReplyTo": {
     "type": "string"
    },
    "model": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "subject",
    "body",
    "tone",
    "visibility"
   ]
  }
 ]
}