{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "oneOf": [
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "DEMARCHE",
      "THREAT",
      "REASSURANCE"
     ]
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "message": {
     "type": "string"
    },
    "visibility": {
     "anyOf": [
      {
       "type": "string",
       "const": "public"
      },
      {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 2
       }
      }
     ]
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "message",
    "visibility"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "PROPOSE_AGREEMENT"
    },
    "target": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 2
     }
    },
    "agreement": {
     "type": "object",
     "properties": {
      "type": {
       "type": "string",
       "enum": [
        "defense",
        "energy",
        "basing",
        "migration",
        "ceasefire",
        "arms_sale",
        "intel_sharing",
        "secret",
        "non_aggression",
        "guarantee",
        "military_access",
        "defense_cooperation",
        "trade"
       ]
      },
      "parties": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 2
       }
      },
      "terms": {
       "type": "string"
      },
      "endTurn": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "maximum": 9007199254740991
        },
        {
         "type": "null"
        }
       ]
      },
      "visibility": {
       "anyOf": [
        {
         "type": "string",
         "const": "public"
        },
        {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 2
         }
        }
       ]
      }
     },
     "required": [
      "type",
      "parties",
      "terms",
      "endTurn",
      "visibility"
     ]
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "agreement"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "RESPOND_AGREEMENT"
    },
    "agreementId": {
     "type": "string"
    },
    "response": {
     "type": "string",
     "enum": [
      "accept",
      "reject",
      "counter"
     ]
    },
    "counterTerms": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "agreementId",
    "response"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "SANCTION",
      "LIFT_SANCTION"
     ]
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "scope": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "scope"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "BACKCHANNEL"
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "message": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "message"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "NATO_ART4",
      "EU_COUNCIL",
      "UNSC_DRAFT"
     ]
    },
    "subject": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "subject"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "ENERGY_DEAL"
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "infrastructureId": {
     "type": "string"
    },
    "terms": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "infrastructureId",
    "terms"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "AID"
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "amount": {
     "type": "number"
    },
    "type": {
     "type": "string",
     "enum": [
      "economic",
      "military"
     ]
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "amount",
    "type"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "enum": [
      "IMPROVE_RELATIONS",
      "STOP_IMPROVE",
      "RECALL_AMBASSADOR",
      "EXPEL_DIPLOMATS",
      "BREAK_RELATIONS",
      "RESTORE_RELATIONS",
      "ARMS_EMBARGO",
      "LIFT_ARMS_EMBARGO"
     ]
    },
    "target": {
     "type": "string",
     "minLength": 2
    }
   },
   "required": [
    "id",
    "kind",
    "target"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "ULTIMATUM"
    },
    "target": {
     "type": "string",
     "minLength": 2
    },
    "demand": {
     "type": "string"
    },
    "deadlineTurns": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4
    }
   },
   "required": [
    "id",
    "kind",
    "target",
    "demand",
    "deadlineTurns"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "MEDIATE"
    },
    "crisisId": {
     "type": "string"
    },
    "parties": {
     "minItems": 2,
     "maxItems": 2,
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 2
     }
    }
   },
   "required": [
    "id",
    "kind",
    "crisisId",
    "parties"
   ]
  },
  {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "const": "RESOLUTION"
    },
    "forum": {
     "type": "string",
     "enum": [
      "UNSC",
      "UNGA",
      "EU_COUNCIL",
      "NATO",
      "ARAB_LEAGUE",
      "AU"
     ]
    },
    "subject": {
     "type": "string"
    },
    "topic": {
     "default": "other",
     "type": "string",
     "enum": [
      "aggression",
      "sanctions",
      "humanitarian",
      "maritime",
      "nonproliferation",
      "other"
     ]
    },
    "target": {
     "type": "string",
     "minLength": 2
    }
   },
   "required": [
    "id",
    "kind",
    "forum",
    "subject"
   ]
  }
 ]
}