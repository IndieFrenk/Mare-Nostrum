{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "from": {
   "type": "string",
   "minLength": 2
  },
  "to": {
   "type": "string",
   "minLength": 2
  },
  "kind": {
   "type": "string"
  },
  "label": {
   "type": "string"
  },
  "value": {
   "type": "number"
  },
  "decayPerWeek": {
   "default": 0,
   "type": "number",
   "minimum": 0
  },
  "floor": {
   "type": "number"
  },
  "expiresTurn": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "causeRef": {
   "type": "string"
  },
  "visibility": {
   "default": "public",
   "anyOf": [
    {
     "type": "string",
     "const": "public"
    },
    {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 2
     }
    }
   ]
  },
  "turn": {
   "default": 0,
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  }
 },
 "required": [
  "id",
  "from",
  "to",
  "kind",
  "label",
  "value",
  "causeRef"
 ]
}