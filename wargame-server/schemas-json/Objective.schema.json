{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "text": {
   "type": "string"
  },
  "priority": {
   "anyOf": [
    {
     "type": "number",
     "const": 1
    },
    {
     "type": "number",
     "const": 2
    },
    {
     "type": "number",
     "const": 3
    }
   ]
  },
  "metric": {
   "type": "string"
  },
  "progress": {
   "type": "number"
  }
 },
 "required": [
  "id",
  "text",
  "priority",
  "metric",
  "progress"
 ]
}